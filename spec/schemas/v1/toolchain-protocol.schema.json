{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://definitely-stable.github.io/dsh-toolchain/schemas/v1/toolchain-protocol.schema.json",
  "title": "DSH Toolchain Protocol v1",
  "$defs": {
    "severity": {
      "enum": ["info", "warning", "error", "fatal"]
    },
    "evidenceStrength": {
      "enum": ["authoritative", "observed", "derived", "heuristic"]
    },
    "evidenceKind": {
      "enum": ["runtime", "generated-catalog", "composed-config", "package", "manifest", "type-declaration", "source", "heuristic"]
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "strength"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "kind": {"$ref": "#/$defs/evidenceKind"},
        "strength": {"$ref": "#/$defs/evidenceStrength"},
        "source": {"type": "string"},
        "contentHash": {"type": "string"},
        "location": {"type": "string"}
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "severity", "domain", "summary"],
      "properties": {
        "code": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]+$"},
        "severity": {"$ref": "#/$defs/severity"},
        "domain": {"type": "string", "minLength": 1},
        "summary": {"type": "string", "minLength": 1},
        "evidenceIds": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "locations": {"type": "array", "items": {"type": "string"}},
        "repair": {"type": ["object", "null"], "additionalProperties": true}
      }
    },
    "resolvedPackageIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "resolvedBundleIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "patchHash"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "patchHash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "targetResolveRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile"],
      "properties": {
        "profile": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!\\.{1,2}$)(?!node_modules$)[^/\\\\]+$"
        },
        "dshHome": {"type": "string", "minLength": 1},
        "dshPackageRoot": {"type": "string", "minLength": 1},
        "patches": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "targetSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fingerprint", "createdAt", "dsh", "runtime", "profile", "evidence"],
      "properties": {
        "fingerprint": {
          "type": "string",
          "pattern": "^dsh-target-v2:[0-9a-f]{64}$"
        },
        "createdAt": {"type": "string", "format": "date-time"},
        "dsh": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "version"],
          "properties": {
            "name": {"const": "@deepseek-ai/dsh"},
            "version": {"type": "string", "minLength": 1}
          }
        },
        "runtime": {
          "type": "object",
          "additionalProperties": false,
          "required": ["nodeVersion", "platform", "arch"],
          "properties": {
            "nodeVersion": {"type": "string", "minLength": 1},
            "platform": {"type": "string", "minLength": 1},
            "arch": {"type": "string", "minLength": 1}
          }
        },
        "profile": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "bundles", "dependencies", "profilePatchHash", "homePatchHash", "overlayPatchHashes"],
          "properties": {
            "name": {"type": "string", "minLength": 1},
            "bundles": {
              "type": "array",
              "items": {"$ref": "#/$defs/resolvedBundleIdentity"}
            },
            "dependencies": {
              "type": "array",
              "items": {"$ref": "#/$defs/resolvedPackageIdentity"}
            },
            "profilePatchHash": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "homePatchHash": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "overlayPatchHashes": {
              "type": "array",
              "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
            }
          }
        },
        "supportStatus": {"enum": ["tested", "supported", "experimental", "unsupported"]},
        "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}}
      }
    },
    "targetResolveResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["snapshot"],
      "properties": {
        "snapshot": {"$ref": "#/$defs/targetSnapshot"}
      }
    },
    "contractKind": {
      "enum": ["service", "method", "event", "tool", "client-slot", "config", "package"]
    },
    "contractAvailability": {
      "enum": ["available", "unavailable", "unknown"]
    },
    "contractFact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "value", "evidenceIds"],
      "properties": {
        "key": {"type": "string", "minLength": 1},
        "value": {"type": "string"},
        "evidenceIds": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "minItems": 1,
          "uniqueItems": true
        }
      }
    },
    "contractReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "name", "qualifiedName", "availability", "score", "evidenceIds"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "kind": {"$ref": "#/$defs/contractKind"},
        "name": {"type": "string", "minLength": 1},
        "qualifiedName": {"type": "string", "minLength": 1},
        "availability": {"$ref": "#/$defs/contractAvailability"},
        "score": {"type": "integer", "minimum": 0},
        "summary": {"type": "string"},
        "evidenceIds": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        }
      }
    },
    "contractDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "name", "qualifiedName", "availability", "facts", "evidenceIds"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "kind": {"$ref": "#/$defs/contractKind"},
        "name": {"type": "string", "minLength": 1},
        "qualifiedName": {"type": "string", "minLength": 1},
        "availability": {"$ref": "#/$defs/contractAvailability"},
        "summary": {"type": "string"},
        "facts": {
          "type": "array",
          "items": {"$ref": "#/$defs/contractFact"}
        },
        "evidenceIds": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        }
      }
    },
    "contractSearchRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "query"],
      "properties": {
        "target": {"$ref": "#/$defs/targetResolveRequest"},
        "query": {"type": "string", "minLength": 1},
        "kinds": {
          "type": "array",
          "items": {"$ref": "#/$defs/contractKind"},
          "uniqueItems": true
        },
        "limit": {"type": "integer", "minimum": 1, "maximum": 25}
      }
    },
    "contractSearchResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contractIndexFingerprint", "matches", "evidence"],
      "properties": {
        "contractIndexFingerprint": {
          "type": "string",
          "pattern": "^dsh-contract-index-v1:[0-9a-f]{64}$"
        },
        "matches": {
          "type": "array",
          "items": {"$ref": "#/$defs/contractReference"}
        },
        "evidence": {
          "type": "array",
          "items": {"$ref": "#/$defs/evidence"}
        }
      }
    },
    "contractInspectRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "contractIndexFingerprint", "contractId"],
      "properties": {
        "target": {"$ref": "#/$defs/targetResolveRequest"},
        "contractIndexFingerprint": {
          "type": "string",
          "pattern": "^dsh-contract-index-v1:[0-9a-f]{64}$"
        },
        "contractId": {"type": "string", "minLength": 1}
      }
    },
    "contractInspectResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contractIndexFingerprint", "contract", "evidence"],
      "properties": {
        "contractIndexFingerprint": {
          "type": "string",
          "pattern": "^dsh-contract-index-v1:[0-9a-f]{64}$"
        },
        "contract": {"$ref": "#/$defs/contractDefinition"},
        "evidence": {
          "type": "array",
          "items": {"$ref": "#/$defs/evidence"}
        }
      }
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "state"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "state": {"enum": ["queued", "running", "input-required", "succeeded", "failed", "cancelled"]},
        "progress": {"type": "number", "minimum": 0, "maximum": 1},
        "message": {"type": "string"}
      }
    },
    "validationReport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "diagnostics"],
      "properties": {
        "status": {"enum": ["passed", "failed", "partial"]},
        "diagnostics": {"type": "array", "items": {"$ref": "#/$defs/diagnostic"}},
        "checks": {"type": "array", "items": {"type": "string"}}
      }
    },
    "verificationReport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "artifactFingerprint", "targetFingerprint", "executionPolicy", "checks", "diagnostics", "cleanup"],
      "properties": {
        "status": {"enum": ["verified", "failed", "partial", "stale", "cancelled"]},
        "artifactFingerprint": {"type": "string", "minLength": 16},
        "targetFingerprint": {"type": "string", "minLength": 16},
        "executionPolicy": {"enum": ["safe", "trusted"]},
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "status"],
            "properties": {
              "id": {"enum": ["structure", "manifest", "dependency", "contract", "build", "package", "install", "compose", "boot", "visibility", "behavior"]},
              "status": {"enum": ["passed", "failed", "skipped"]},
              "reason": {"type": "string"}
            }
          }
        },
        "diagnostics": {"type": "array", "items": {"$ref": "#/$defs/diagnostic"}},
        "cleanup": {"enum": ["succeeded", "failed", "not-required"]}
      }
    },
    "responseEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocolVersion", "requestId", "status", "diagnostics"],
      "properties": {
        "protocolVersion": {"const": "1"},
        "requestId": {"type": "string", "minLength": 1},
        "snapshotFingerprint": {"type": "string", "minLength": 16},
        "status": {"enum": ["ok", "failed", "partial", "stale", "cancelled"]},
        "data": {},
        "diagnostics": {"type": "array", "items": {"$ref": "#/$defs/diagnostic"}}
      }
    },
    "targetResolveSuccessResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocolVersion", "requestId", "snapshotFingerprint", "status", "data", "diagnostics"],
      "properties": {
        "protocolVersion": {"const": "1"},
        "requestId": {"type": "string", "minLength": 1},
        "snapshotFingerprint": {
          "type": "string",
          "pattern": "^dsh-target-v2:[0-9a-f]{64}$"
        },
        "status": {"const": "ok"},
        "data": {"$ref": "#/$defs/targetResolveResult"},
        "diagnostics": {"type": "array", "items": {"$ref": "#/$defs/diagnostic"}}
      }
    },
    "targetResolveFailureResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocolVersion", "requestId", "status", "diagnostics"],
      "properties": {
        "protocolVersion": {"const": "1"},
        "requestId": {"type": "string", "minLength": 1},
        "status": {"const": "failed"},
        "diagnostics": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/diagnostic"}
        }
      }
    },
    "targetResolveResponse": {
      "oneOf": [
        {"$ref": "#/$defs/targetResolveSuccessResponse"},
        {"$ref": "#/$defs/targetResolveFailureResponse"}
      ]
    },
    "contractSearchSuccessResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocolVersion", "requestId", "snapshotFingerprint", "status", "data", "diagnostics"],
      "properties": {
        "protocolVersion": {"const": "1"},
        "requestId": {"type": "string", "minLength": 1},
        "snapshotFingerprint": {"type": "string", "pattern": "^dsh-target-v2:[0-9a-f]{64}$"},
        "status": {"const": "ok"},
        "data": {"$ref": "#/$defs/contractSearchResult"},
        "diagnostics": {"type": "array", "items": {"$ref": "#/$defs/diagnostic"}}
      }
    },
    "contractSearchFailureResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocolVersion", "requestId", "status", "diagnostics"],
      "properties": {
        "protocolVersion": {"const": "1"},
        "requestId": {"type": "string", "minLength": 1},
        "status": {"const": "failed"},
        "diagnostics": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/diagnostic"}}
      }
    },
    "contractSearchStaleResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocolVersion", "requestId", "snapshotFingerprint", "status", "diagnostics"],
      "properties": {
        "protocolVersion": {"const": "1"},
        "requestId": {"type": "string", "minLength": 1},
        "snapshotFingerprint": {"type": "string", "pattern": "^dsh-target-v2:[0-9a-f]{64}$"},
        "status": {"const": "stale"},
        "diagnostics": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/diagnostic"}}
      }
    },
    "contractSearchResponse": {
      "oneOf": [
        {"$ref": "#/$defs/contractSearchSuccessResponse"},
        {"$ref": "#/$defs/contractSearchFailureResponse"},
        {"$ref": "#/$defs/contractSearchStaleResponse"}
      ]
    },
    "contractInspectSuccessResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocolVersion", "requestId", "snapshotFingerprint", "status", "data", "diagnostics"],
      "properties": {
        "protocolVersion": {"const": "1"},
        "requestId": {"type": "string", "minLength": 1},
        "snapshotFingerprint": {"type": "string", "pattern": "^dsh-target-v2:[0-9a-f]{64}$"},
        "status": {"const": "ok"},
        "data": {"$ref": "#/$defs/contractInspectResult"},
        "diagnostics": {"type": "array", "items": {"$ref": "#/$defs/diagnostic"}}
      }
    },
    "contractInspectFailureResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocolVersion", "requestId", "status", "diagnostics"],
      "properties": {
        "protocolVersion": {"const": "1"},
        "requestId": {"type": "string", "minLength": 1},
        "status": {"const": "failed"},
        "diagnostics": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/diagnostic"}}
      }
    },
    "contractInspectStaleResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocolVersion", "requestId", "snapshotFingerprint", "status", "diagnostics"],
      "properties": {
        "protocolVersion": {"const": "1"},
        "requestId": {"type": "string", "minLength": 1},
        "snapshotFingerprint": {"type": "string", "pattern": "^dsh-target-v2:[0-9a-f]{64}$"},
        "status": {"const": "stale"},
        "diagnostics": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/diagnostic"}}
      }
    },
    "contractInspectResponse": {
      "oneOf": [
        {"$ref": "#/$defs/contractInspectSuccessResponse"},
        {"$ref": "#/$defs/contractInspectFailureResponse"},
        {"$ref": "#/$defs/contractInspectStaleResponse"}
      ]
    }
  },
  "$ref": "#/$defs/responseEnvelope"
}