{
  "name": "dsh-toolchain",
  "version": "0.0.0",
  "description": "Development toolchain for DeepSeek Harness plugins",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./dsh": {
      "types": "./lib/integrations/dsh/index.d.ts",
      "default": "./lib/integrations/dsh/index.js"
    },
    "./protocol": {
      "types": "./lib/protocol/index.d.ts",
      "default": "./lib/protocol/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "dsh-toolchain": "./lib/frontends/cli/bin.js",
    "dsh-toolchain-mcp": "./lib/frontends/mcp/bin.js"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "spec/schemas/v1/*.json",
    "skills/dsh-toolchain",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "generate": "node scripts/generate-protocol.mjs",
    "m2:h1:preregister": "node scripts/prepare-m2-h1-preregistration.mjs",
    "m2:h1:run": "node scripts/run-m2-h1-opencode-go.mjs",
    "m2:h1:finalize": "node scripts/finalize-m2-h1.mjs",
    "m2:h1:post-analyze": "node scripts/post-analyze-m2-h1.mjs",
    "eval:plan": "node scripts/eval/budget-plan.mjs",
    "eval:select": "node scripts/eval/development-corpus.mjs",
    "eval:health": "node scripts/eval/health-gate.mjs",
    "eval:audit-h1": "node scripts/eval/audit-h1-health.mjs",
    "eval:run": "node scripts/eval/run-staged.mjs",
    "check:generated": "node scripts/generate-protocol.mjs --check",
    "check:protocol": "node scripts/check-protocol.mjs",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check:package": "node scripts/check-package-policy.mjs",
    "check:ci-storage": "node scripts/check-ci-storage-policy.mjs",
    "check:scripts": "tsc -p tsconfig.scripts.json --noEmit",
    "lint": "oxlint src tests scripts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "build": "pnpm run clean && tsc -p tsconfig.build.json",
    "check": "pnpm run check:generated && pnpm run check:protocol && pnpm run check:architecture && pnpm run check:package && pnpm run check:ci-storage && pnpm run lint && pnpm run typecheck && pnpm run check:scripts && pnpm run test",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "typescript": "6.0.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@types/node": "^22.20.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "oxlint": "1.80.0",
    "vitest": "4.1.11"
  }
}
